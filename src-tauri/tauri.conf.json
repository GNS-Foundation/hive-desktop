{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GEIANT Hive",
  "version": "0.1.5",
  "identifier": "com.geiant.hive-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GEIANT Hive \u2014 Setup",
        "width": 720,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
